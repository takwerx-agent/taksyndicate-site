---
import Base from '../layouts/Base.astro';
// [logo, name, what they do, url]
const links = [
  ['/images/img-014.webp', 'The TAK Syndicate', 'Community · Video', 'https://www.youtube.com/@thetaksyndicate6234/'],
  ['/images/links/tak-gov.svg', 'TAK.gov', 'Official · TAK Product Center', 'https://tak.gov'],
  ['/images/links/atak-civ-google-play.svg', 'ATAK-CIV', 'Official · Google Play', 'https://play.google.com/store/apps/details?id=com.atakmap.app.civ'],
  ['/images/links/atak-map.webp', 'ATAK Map', 'Community · Video', 'https://www.youtube.com/@ATAKMap'],
  ['/images/links/colorado-coe.webp', 'Colorado CoE', 'Official · COTAK', 'https://cofiretech.gov/'],
  ['/images/links/civtak.webp', 'CivTAK', 'Community', 'https://www.civtak.org/'],
  ['/images/links/mytecknet.webp', 'myTeckNet', 'Community · TAK Server guides', 'https://mytecknet.com/tag/tak/'],
  ['/images/img-020.webp', 'Mapping Support', 'Map data · Community', 'https://mappingsupport.com/p2/atak/display_gis_data_with_atak.html'],
  ['/images/links/opentakserver.webp', 'OpenTAKServer', 'Community · Open-source TAK server', 'https://opentakserver.io'],
  ['/images/links/gotak.svg', 'GoTAK', 'Hardware · TAK as a service · Development · Training', 'https://getgotak.com/'],
  ['/images/links/rtx-bbn.webp', 'RTX BBN TAK Ops', 'TAK as a service · Training · Development · Hardware', 'https://tak-ops.com/'],
  ['/images/links/booz-allen.svg', 'Booz Allen', 'Sit(x) · TAK as a service', 'https://www.boozallen.com/expertise/products/sitx-situational-awareness-in-real-time.html'],
  ['/images/links/parsons.svg', 'Parsons', 'TAK as a service · Development', 'https://www.parsons.com/products/takaas/'],
  ['/images/links/eotak.webp', 'EOTAK', 'TAK as a service', 'https://eotak.com/'],
  ['/images/links/takgrid.svg', 'TAKGRID', 'TAK as a service', 'https://takgrid.com/'],
  ['/images/links/sensors-and-signals.webp', 'Sensors & Signals', 'Integration · TAK as a service · Development · Training', 'https://www.snstac.com/'],
  ['/images/links/defsec.svg', 'DEFSEC Technologies', 'Development · TAK as a service · formerly KWESST', 'https://defsectec.com/lightning/'],
  ['/images/links/syzygy-integration.webp', 'Syzygy Integration', 'Integration · Development', 'https://syzygyintegration.com/'],
  ['/images/links/realm.svg', 'Realm Alliance', 'TAK services', 'https://realmalliance.com/'],
  ['/images/links/tough-stump.webp', 'Tough Stump', 'Training · Integration', 'https://toughstump.com/'],
  ['/images/links/district47.svg', 'District 47', 'Map data · Training · Hardware', 'https://district47.us/'],
  ['/images/links/4k-solutions.svg', '4K Solutions', 'Comms · Hardware · Training', 'https://4ksolutions.com/solutions/android-tactical-assault-kit/'],
  ['/images/links/flight-tactics.svg', 'Flight Tactics', 'Development · TAK Aware for iOS', 'https://www.flighttactics.com/'],
  ['/images/links/eolianvr.webp', 'EolianVR', 'Development · ARTAK (AR/VR TAK)', 'https://www.eolianvr.com/artak'],
  ['/images/links/sigma-defense.svg', 'Sigma Defense', 'Development · Integration · now owns Aries Defense', 'https://sigmadefense.com/'],
  ['/images/links/skydio.svg', 'Skydio', 'Drones · Integration', 'https://www.skydio.com/blog/skydio-x10d-integrates-with-atak-for-tactical-isr'],
  ['/images/links/darkhive.svg', 'Darkhive', 'Integration · Drones', 'https://www.darkhive.com/solutions'],
  ['/images/img-036.webp', 'Squishy Robotics', 'Integration · Hazmat robots', 'https://squishy-robotics.com/third-party-integrations/'],
  ['/images/links/overwatch-aero.webp', 'Overwatch Aero', 'Aerial ISR', 'https://overwatchaero.com/'],
  ['/images/links/crg.svg', 'Critical Response Group', 'Map data · Response graphics', 'https://www.crgplans.com/'],
  ['/images/links/beartooth.webp', 'Beartooth', 'Comms · Hardware', 'https://beartooth.com/'],
  ['/images/links/somewear-labs.svg', 'Somewear Labs', 'Comms · Hardware', 'https://somewearlabs.com/'],
  ['/images/links/gotenna.svg', 'goTenna', 'Comms · Hardware · now Forterra', 'https://www.forterra.com/gotenna'],
  ['/images/links/doodle-labs.webp', 'Doodle Labs', 'Comms · Hardware', 'https://doodlelabs.com/products/radios/wearable/'],
  ['/images/links/nokia-federal.svg', 'Nokia Federal', 'Comms · formerly Fenix Group', 'https://www.nokiafederal.com/solutions/tactical-private-wireless/'],
  ['/images/links/samsung.svg', 'Samsung', 'Hardware · Public safety devices', 'https://www.samsung.com/us/business/solutions/industries/public-safety/'],
  ['/images/links/juggernaut-case.webp', 'Juggernaut.Case', 'Hardware · Cases & mounts', 'https://juggernautcase.com/'],
];
---
<Base title="Links" description="Vendors, agencies, communities and tools across the TAK ecosystem.">
  <main id="main">
    <div class="wrap">
      <div class="page-head">
        <h1>Links</h1>
        <p>Vendors, agencies, communities and tools across the TAK ecosystem. Listed to help you find your way, not as endorsements.</p>
      </div>
      <div class="lk-grid">
        {links.map(([img, name, kind, href]) => (
          <a class="lk-card" href={href} target="_blank" rel="noopener">
            <span class="lk-logo"><img src={img} alt={`${name} logo`} loading="lazy" /></span>
            <span class="lk-plate"><strong>{name}</strong><small>{kind}</small></span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
