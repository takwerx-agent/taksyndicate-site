---
import Base from '../layouts/Base.astro';

const cards = [
  ['/faq/',                    'New to TAK?',          'What TAK is, what it costs, which version you need, and where to get it.'],
  ['/infra-tak/',              'infra-TAK',            'A free, open-source console that stands up a TAK Server stack. No more SSH.'],
  ['/plugins/',                'ATAK plugins',         'Free plugins like PLSS Grid — downloads, guides and version matrix.'],
  ['/tools/',                  'Open-source tools',    'Community installers, video servers and CloudTAK plugins.'],
  ['/who-is-using-tak/',       'Who’s using TAK',      'A live map of agencies and organizations running TAK in the field.'],
  ['/links/',                  'The ecosystem',        'Vendors, agencies, communities and tools across the TAK landscape.'],
];
const domains = [
  ['Wildfire',        'var(--d-fire)'],
  ['Hazmat',          'var(--d-hazmat)'],
  ['Active threat',   'var(--d-threat)'],
  ['Search & rescue', 'var(--d-sar)'],
  ['Flood & water',   'var(--d-water)'],
  ['Law enforcement', 'var(--d-le)'],
  ['EMS',             'var(--d-ems)'],
  ['Planned events',  'var(--d-events)'],
];
const videos = ['CSbLibPAcQk', 'tojMXYMVdyw'];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Advocating for the Team Awareness Kit</span>
        <h1>Shared awareness for <em>every responder.</em></h1>
        <p class="lede">
          The TAK Syndicate is an ad-hoc group of focused professionals collaborating to promote
          the Team Awareness Kit as a tool to enhance efficiency, effectiveness and overall safety
          for emergency response — across every discipline, from the fire line to the hot zone.
          Nothing for sale. Just practitioners sharing what works.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/faq/">What is TAK?</a>
          <a class="btn btn-ghost" href="/who-we-are/">Who we are</a>
        </div>
      </div>

      <figure class="cop" aria-label="Illustration of a shared operating picture with several incidents on one map">
        <div class="cop-bar"><span>One map, many disciplines</span><span>Illustration</span></div>
        <svg viewBox="0 0 520 330" role="img" aria-hidden="true" style="font-family: var(--mono)">
          <defs>
            <pattern id="g" width="26" height="26" patternUnits="userSpaceOnUse">
              <path d="M26 0H0V26" fill="none" style="stroke: var(--grid)" />
            </pattern>
            <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="6" style="stroke: var(--d-sar)" stroke-width="1.2" opacity=".5" />
            </pattern>
          </defs>
          <rect width="520" height="330" fill="url(#g)" />
          <!-- terrain contours -->
          <g fill="none" style="stroke: var(--muted)" opacity=".22" stroke-width="1">
            <path d="M-10 70 C80 40 150 90 230 60 S380 20 530 60" />
            <path d="M-10 95 C70 70 160 115 240 88 S390 50 530 88" />
            <path d="M40 300 C90 250 170 260 200 230 S260 170 330 190 S440 260 530 230" />
            <path d="M70 330 C110 285 180 290 215 262 S280 210 335 222 S450 290 530 262" />
          </g>
          <!-- river -->
          <path d="M-10 190 C60 170 110 210 170 195 S270 150 320 165 S430 215 530 200" fill="none" style="stroke: var(--d-water)" stroke-width="3" opacity=".55" />
          <!-- roads -->
          <g fill="none" style="stroke: var(--muted)" opacity=".35" stroke-width="1.5" stroke-dasharray="1 0">
            <path d="M0 250 L520 120" /><path d="M300 0 L360 330" />
          </g>

          <!-- wildfire perimeter -->
          <path d="M70 52 L128 36 L170 58 L182 104 L150 132 L96 128 L62 96 Z" style="fill: var(--d-fire); stroke: var(--d-fire)" fill-opacity=".14" stroke-width="2" stroke-dasharray="6 4" />
          <text x="76" y="86" font-size="10" style="fill: var(--d-fire)" letter-spacing=".08em">RIDGE FIRE</text>
          <text x="76" y="99" font-size="8.5" style="fill: var(--muted)">412 AC · 30%</text>

          <!-- hazmat plume -->
          <path d="M398 74 L500 30 L506 110 Z" style="fill: var(--d-hazmat)" fill-opacity=".14" />
          <path d="M398 74 L500 30 M398 74 L506 110" style="stroke: var(--d-hazmat)" stroke-width="1.2" stroke-dasharray="3 3" />
          <polygon points="398,64 408,74 398,84 388,74" style="fill: var(--d-hazmat)" />
          <text x="410" y="96" font-size="9" style="fill: var(--d-hazmat)" letter-spacing=".08em">HAZMAT · NH3</text>

          <!-- active threat with cordon -->
          <circle cx="250" cy="250" r="36" fill="none" style="stroke: var(--d-threat)" stroke-width="1.5" stroke-dasharray="4 4" />
          <polygon points="250,238 262,250 250,262 238,250" style="fill: var(--d-threat)" />
          <text x="292" y="282" font-size="9" style="fill: var(--d-threat)" letter-spacing=".08em">LOCKDOWN</text>

          <!-- SAR search segment -->
          <rect x="400" y="200" width="92" height="70" style="stroke: var(--d-sar)" fill="url(#hatch)" stroke-width="1.5" />
          <text x="404" y="286" font-size="9" style="fill: var(--d-sar)" letter-spacing=".08em">SEG 4B</text>

          <!-- friendly units -->
          <g style="fill: var(--surface); stroke: var(--accent)" stroke-width="1.6">
            <rect x="190" y="112" width="22" height="14" /><rect x="352" y="96" width="22" height="14" />
            <rect x="196" y="282" width="22" height="14" /><rect x="438" y="168" width="22" height="14" />
            <rect x="120" y="160" width="22" height="14" />
          </g>
          <g font-size="8.5" style="fill: var(--text)">
            <text x="216" y="123">E-21</text><text x="378" y="107">HM-1</text>
            <text x="222" y="293">SWAT</text><text x="464" y="179">K9-2</text>
            <text x="146" y="171">M-7</text>
          </g>
          <!-- shared link lines -->
          <g style="stroke: var(--accent)" opacity=".35" stroke-width="1" stroke-dasharray="2 4">
            <path d="M212 119 L352 103" /><path d="M142 167 L196 289" /><path d="M374 103 L438 175" />
          </g>
          <text x="10" y="322" font-size="8" style="fill: var(--muted)" letter-spacing=".06em">38.5816° N  121.4944° W</text>
        </svg>
        <figcaption class="cop-foot">
          <span style="color: var(--accent)">Responders</span>
          <span style="color: var(--d-fire)">Fire</span>
          <span style="color: var(--d-hazmat)">Hazmat</span>
          <span style="color: var(--d-threat)">Threat</span>
          <span style="color: var(--d-sar)">SAR</span>
        </figcaption>
      </figure>
    </div>

    <div class="domains">
      <div class="wrap">
        {domains.map(([label, c]) => (
          <span class="domain" style={`--c: ${c}`}><i></i>{label}</span>
        ))}
      </div>
    </div>
  </section>

  <main id="main">
    <div class="wrap">
      <h2 class="section-title" style="margin-top: 0"><b>01</b> Learn &amp; share</h2>
      <div class="card-grid">
        {cards.map(([href, title, body], i) => (
          <a class="card" href={href}>
            <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </a>
        ))}
      </div>

      <h2 class="section-title"><b>02</b> Watch</h2>
      <div class="video-grid">
        {videos.map((id) => (
          <div class="embed">
            <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} loading="lazy"
              title="The TAK Syndicate video" allowfullscreen
              allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
          </div>
        ))}
      </div>
    </div>
  </main>
</Base>
