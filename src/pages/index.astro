---
import Base from '../layouts/Base.astro';
import { plugins } from '../lib/plugins.js';

const cards = [
  ['/faq/',                    'New to TAK?',          'What TAK is, what it costs, which version you need, and where to get it.'],
  ['/infra-tak/',              'infra-TAK',            'A free, open-source console that stands up a TAK Server stack. No more SSH.'],
  ['/plugins/',                'ATAK plugins',         'Free plugins like PLSS Grid — downloads, guides and version matrix.'],
  ['/takwerx/',                'TAKwerx',              'The open-source hub: infra-TAK, ATAK and CloudTAK plugins, and where to report problems.'],
  ['/who-is-using-tak/',       'Who’s using TAK',      'A live map of agencies and organizations running TAK in the field.'],
  ['/links/',                  'The ecosystem',        'Vendors, agencies, communities and tools across the TAK landscape.'],
];
const domains = [
  ['Wildfire',        'var(--d-fire)'],
  ['Hazmat',          'var(--d-hazmat)'],
  ['Active threat',   'var(--d-threat)'],
  ['Search & rescue', 'var(--d-sar)'],
  ['Flood & water',   'var(--d-water)'],
  ['Law enforcement', 'var(--d-le)'],
  ['EMS',             'var(--d-ems)'],
  ['Planned events',  'var(--d-events)'],
];
const videos = ['CSbLibPAcQk', 'tojMXYMVdyw'];
// Screenshots from real incidents (from the original site's slideshow). [image, caption, discipline color]
const slides = [
  ['/images/field/01.webp', 'Wildfire: aircraft video beside the map',          'var(--d-fire)'],
  ['/images/field/02.webp', 'Wildfire: a hotspot camera paired to the fire',    'var(--d-fire)'],
  ['/images/field/03.webp', 'Wildfire: divisions along the perimeter',          'var(--d-fire)'],
  ['/images/field/04.webp', 'Planned event: every agency on one map',           'var(--d-le)'],
  ['/images/field/05.webp', 'Wildfire: the perimeter on a topo base map',       'var(--d-fire)'],
  ['/images/field/06.webp', 'Hurricane Ian: the advisory on the map',           'var(--d-water)'],
  ['/images/field/07.webp', 'Backcountry: trails on a topo base map',           'var(--d-sar)'],
  ['/images/field/08.webp', 'Swift-water rescue: units along the channel',      'var(--d-water)'],
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Advocating for the Team Awareness Kit</span>
        <h1>Shared consciousness for <em>every responder.</em></h1>
      </div>
      <div class="hero-side">
        <img class="hero-logo" src="/brand/logo-360.webp" alt="The TAK Syndicate shield" width="180" height="180" />
        <p class="lede">
          The TAK Syndicate is an ad-hoc group of focused professionals collaborating to promote
          the Team Awareness Kit as a tool to enhance efficiency, effectiveness and overall safety
          for emergency response — across every discipline, from the fire line to the hot zone.
          Nothing for sale. Just practitioners sharing what works.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/faq/">What is TAK?</a>
          <a class="btn btn-ghost" href="/plugins/">Browse TAKwerx plugins</a>
        </div>
      </div>
    </div>

    <div class="field-wrap">
      <figure class="cop field" aria-roledescription="carousel" aria-label="TAK in the field">
        <div class="cop-bar"><span>TAK in the field</span><span class="field-count"><b>●</b> <span>1</span> / {slides.length}</span></div>
        <div class="field-stage">
          {slides.map(([src, cap, tag], i) => (
            <figure class:list={['field-slide', i === 0 && 'on']} aria-hidden={i === 0 ? undefined : 'true'}>
              <img src={src} alt={cap} width="1600" height="720" loading={i === 0 ? 'eager' : 'lazy'} />
              <figcaption style={`--c: ${tag}`}><i></i>{cap}</figcaption>
            </figure>
          ))}
          <button class="field-nav prev" type="button" aria-label="Previous">‹</button>
          <button class="field-nav next" type="button" aria-label="Next">›</button>
        </div>
        <div class="field-dots">
          {slides.map((_, i) => <button type="button" aria-label={`Slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
        </div>
      </figure>
    </div>

    <div class="domains">
      <div class="wrap">
        {domains.map(([label, c]) => (
          <span class="domain" style={`--c: ${c}`}><i></i>{label}</span>
        ))}
      </div>
    </div>
  </section>

  <main id="main">
    <div class="wrap">
      <h2 class="section-title" style="margin-top: 0"><b>01</b> Learn &amp; share</h2>
      <div class="card-grid">
        {cards.map(([href, title, body], i) => (
          <a class="card" href={href}>
            <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </a>
        ))}
      </div>

      <section class="tw-band">
        <div>
          <span class="tw-kicker">Built in the open</span>
          <h2>TAKwerx</h2>
          <p>TAKwerx is the open-source workshop of The TAK Syndicate. A working first responder builds the TAK tools the field keeps asking for: a server stack you can stand up from a browser, ATAK plugins for fire, weather, hazmat and SAR, CloudTAK plugins, and ATAK on your desktop. Everything is free, the code is on GitHub, and every problem you report goes straight to the person who fixes it.</p>
          <a class="btn btn-ghost" href="/takwerx/">Explore TAKwerx</a>
        </div>
        <div class="tw-band-links">
          <a href="/atak-terminal/"><strong>ATAK Terminal</strong><span>Real ATAK in a window on your Mac or PC</span></a>
          <a href="/infra-tak/"><strong>infra-TAK</strong><span>The whole TAK stack from one browser console</span></a>
          <a href="/plugins/"><strong>ATAK plugins</strong><span>{plugins.length} plugins, one Market to install them</span></a>
          <a href="/takwerx/#cloudtak"><strong>CloudTAK plugins</strong><span>Dispatch and live exercises in CloudTAK</span></a>
          <a href="/takwerx/#report"><strong>Report a problem</strong><span>Straight to the right issue tracker</span></a>
          <a href="https://github.com/takwerx"><strong>GitHub</strong><span>Every line of code, in the open</span></a>
        </div>
      </section>

      <h2 class="section-title"><b>02</b> Watch</h2>
      <div class="video-grid">
        {videos.map((id) => (
          <div class="embed">
            <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} loading="lazy"
              title="The TAK Syndicate video" allowfullscreen
              allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
          </div>
        ))}
      </div>
    </div>
  </main>
  <script is:inline>
    (function () {
      var root = document.querySelector('.field'); if (!root) return;
      var slides = root.querySelectorAll('.field-slide'), dots = root.querySelectorAll('.field-dots button');
      var count = root.querySelector('.field-count span'), i = 0, timer = null;
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function show(n) {
        i = (n + slides.length) % slides.length;
        slides.forEach(function (s, k) { s.classList.toggle('on', k === i); s.setAttribute('aria-hidden', k === i ? 'false' : 'true'); });
        dots.forEach(function (d, k) { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
        count.textContent = i + 1;
        var next = slides[(i + 1) % slides.length].querySelector('img'); next.loading = 'eager';
      }
      function play() { if (!still) { stop(); timer = setInterval(function () { show(i + 1); }, 5500); } }
      function stop() { clearInterval(timer); }
      root.querySelector('.prev').onclick = function () { show(i - 1); play(); };
      root.querySelector('.next').onclick = function () { show(i + 1); play(); };
      dots.forEach(function (d, k) { d.onclick = function () { show(k); play(); }; });
      root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', play);
      var x0 = null;
      root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', function (e) { if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); play(); } x0 = null; });
      play();
    })();
  </script>
</Base>
