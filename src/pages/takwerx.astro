---
import Base from '../layouts/Base.astro';
import { plugins, community, featured, terminalPlugins } from '../lib/plugins.js';

const GH = 'https://github.com/takwerx';

const cloudtak = [
  { name: 'Dispatcher', tag: 'TAK Portal · GitHub', href: `${GH}/cloudtak-dispatcher-plugin`, cta: 'Source & changelog on GitHub →',
    blurb: 'Create and manage incidents on the map, organize them under named events, assign responders, and notify them through mission chat and GeoChat.' },
  { name: 'TAK Simulator', tag: 'infra-TAK only', href: `${GH}/infra-TAK/blob/main/docs/SIMULATOR.md`, cta: 'How the Simulator works →',
    blurb: 'A director panel inside CloudTAK for live exercises, demos and load tests: scripted units on an isolated simulation channel, eight ready-made scenarios, and a clean stop that removes everything. Requires infra-TAK with CloudTAK on the same server.' },
];

const more = [
  { name: 'MediaMTX Installer', repo: 'mediamtx-installer', tag: 'Video · Standalone', blurb: 'Video streaming for drones, cameras and tactical feeds (RTSP, RTMP, HLS, SRT), with a web configuration editor.' },
  { name: 'TAK Server Installer', repo: 'tak-server-installer', tag: 'Server · Standalone', blurb: 'Scripts that install and harden TAK Server on Rocky Linux 9 or Ubuntu 22.04, with SSL through Caddy.' },
  { name: 'ATAK Plugin Pipeline', repo: 'atak-plugin-pipeline', tag: 'Developers', blurb: 'How TAKwerx builds ATAK plugins and gets them through TAK’s third-party signing pipeline, as a Claude Code skill.' },
];

// Every place a problem can be reported, for the picker.
const issueTargets = [
  ['infra-TAK', 'infra-TAK'],
  ...plugins.map((p) => [`${p.name} (ATAK plugin)`, p.repo.split('/')[1]]),
  ['ATAK Terminal', 'atak-terminal'],
  ...terminalPlugins.map((p) => [`${p.name} (ATAK Terminal)`, p.repo.split('/')[1]]),
  ['Dispatcher (CloudTAK plugin)', 'cloudtak-dispatcher-plugin'],
  ['TAK Simulator (infra-TAK module)', 'infra-TAK'],
  ...more.map((m) => [m.name, m.repo]),
];
---
<Base title="TAKwerx" description="TAKwerx is the open-source workshop behind infra-TAK, the TAKwerx ATAK plugins and CloudTAK plugins — downloads, source and where to report problems.">
  <main id="main">
    <div class="wrap">
      <div class="page-head">
        <h1>TAKwerx</h1>
        <p>The open-source workshop behind the ATAK Terminal, infra-TAK, and the TAKwerx ATAK and CloudTAK plugins. Built by a first responder, free for everyone, and all of it on GitHub.</p>
      </div>
      <div class="tw-hubs">
        <a class="tw-hub" href="/atak-terminal/">
          <span class="tw-kicker">Desktop · New beta</span>
          <h2>ATAK Terminal</h2>
          <p>Real ATAK, with its real plugins, in a window on your Mac or Windows PC. Download ATAK-CIV from tak.gov, paste one line, and train, build data packages and plan from a desk with a mouse and a big screen.</p>
          <span class="tw-stat"><b>2</b> steps · <b>0</b> accounts</span>
          <span class="repo-cta">See how it works →</span>
        </a>
        <a class="tw-hub" href="/infra-tak/">
          <span class="tw-kicker">Server side</span>
          <h2>infra-TAK</h2>
          <p>One web console that deploys and runs the whole TAK stack: TAK Server, Authentik, TAK Portal, SSL, CloudTAK, video, Node-RED and health monitoring. Upload your TAK Server installer package, set a password, and drive the rest from the browser.</p>
          <span class="tw-stat"><b>1</b> console · <b>9</b> services</span>
          <span class="repo-cta">Install guide →</span>
        </a>
        <a class="tw-hub" href="/plugins/">
          <span class="tw-kicker">ATAK · CloudTAK</span>
          <h2>Plugins</h2>
          <p>We build plugins for both ATAK and CloudTAK. ATAK plugins for maps, weather, fire, alerts, airspace, cameras and comms install and update from inside ATAK through {featured?.name}. CloudTAK plugins bring dispatch and, with infra-TAK, live exercises to the browser.</p>
          <span class="tw-stat"><b>{plugins.length}</b> ATAK · <b>{cloudtak.length}</b> CloudTAK · <b>{community.length}</b> community</span>
          <span class="repo-cta">Browse the plugins →</span>
        </a>
      </div>

      <h2 class="section-title" id="cloudtak"><b>01</b> CloudTAK plugins</h2>
      <p class="section-note"><strong>Dispatcher</strong> installs and updates from the <strong>TAK Portal marketplace</strong>, or from GitHub for any CloudTAK. <strong>TAK Simulator</strong> needs its engine running beside CloudTAK, so it comes only with <a href="/infra-tak/">infra-TAK</a>: deploy it from the console’s marketplace.</p>
      <div class="card-grid">
        {cloudtak.map((c) => (
          <a class="card repo-card" href={c.href}>
            <span class="card-num">{c.tag}</span>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <span class="repo-cta">{c.cta}</span>
          </a>
        ))}
      </div>

      <h2 class="section-title"><b>02</b> More from TAKwerx</h2>
      <p class="section-note">The two installers below set up MediaMTX or TAK Server on their own. For the easier route, <a href="/infra-tak/">infra-TAK</a> deploys both — and the rest of the stack — from its console.</p>
      <div class="card-grid">
        {more.map((m) => (
          <a class="card repo-card" href={`${GH}/${m.repo}`}>
            <span class="card-num">{m.tag}</span>
            <h3>{m.name}</h3>
            <p>{m.blurb}</p>
            <span class="repo-cta">View on GitHub →</span>
          </a>
        ))}
      </div>

      <h2 class="section-title" id="report"><b>03</b> Report a problem or ask for a feature</h2>
      <div class="tw-report">
        <div class="prose">
          <p>Every TAKwerx project has its own issue tracker on GitHub. That’s where problems get fixed and feature requests get picked up, and anyone hitting the same thing can follow along.</p>
          <h4 class="tw-h4">Include</h4>
          <ul>
            <li>What you did, what you expected, and what happened instead.</li>
            <li>Versions: the plugin or infra-TAK version, and your ATAK or TAK Server version.</li>
            <li>Your device or server (phone model, or OS and cloud provider).</li>
            <li>A screenshot or screen recording, if it shows the problem.</li>
          </ul>
          <p class="section-note">A free GitHub account is all you need. Leave out passwords, keys and anything operationally sensitive — issues are public.</p>
        </div>
        <form class="tw-picker" action="#" onsubmit="event.preventDefault(); var r=this.repo.value; if(r) window.open('https://github.com/takwerx/'+r+'/issues/new','_blank','noopener');">
          <label for="tw-repo">Which project?</label>
          <select id="tw-repo" name="repo" required>
            <option value="">Choose one…</option>
            {issueTargets.map(([label, repo]) => <option value={repo}>{label}</option>)}
          </select>
          <button class="btn btn-primary" type="submit">Open an issue on GitHub</button>
          <a class="tw-browse" href={`${GH}?tab=repositories`}>Or browse every TAKwerx repository →</a>
        </form>
      </div>

      <div class="tw-foot">
        <a class="tw-coffee" href="https://buymeacoffee.com/takwerx" aria-label="Buy TAKwerx a coffee">
          <img src="/brand/takcoffee.webp" alt="A latte with the TAK shield in the foam" width="180" height="180" loading="lazy" />
        </a>
        <div class="tw-foot-text">
          <span class="tw-kicker">Keep it going</span>
          <p>Coffee helps fuel the TAKwerx innovation.</p>
        </div>
        <div class="cta-row">
          <a class="btn btn-ghost" href="https://buymeacoffee.com/takwerx">Buy TAKwerx a coffee</a>
          <a class="btn btn-ghost" href={GH}>TAKwerx on GitHub</a>
        </div>
      </div>
    </div>
  </main>
</Base>
