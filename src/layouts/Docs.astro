---
import Base from './Base.astro';
const { frontmatter, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <main id="main">
    <div class="wrap">
      <div class="page-head">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p>{frontmatter.description}</p>}
      </div>

      {toc.length > 0 && (
        <details class="toc-mobile">
          <summary><b>Jump to</b><span class="toc-now">{toc[0].text}</span><i aria-hidden="true"></i></summary>
          <nav class="toc-list" aria-label="Sections on this page">
            {toc.map((h) => (
              <a href={`#${h.slug}`} class={h.depth === 3 ? 'lvl-3' : ''}>{h.text}</a>
            ))}
          </nav>
        </details>
      )}

      <div class={toc.length ? 'docs' : ''}>
        <article class="prose"><slot /></article>
        {toc.length > 0 && (
          <aside class="toc">
            <div class="toc-title">On this page</div>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class={h.depth === 3 ? 'lvl-3' : ''}>{h.text}</a>
            ))}
          </aside>
        )}
      </div>
    </div>
  </main>
  <script is:inline>
    // Phones: the sticky "Jump to" bar names the section you are in, and closes after a pick.
    (function () {
      var box = document.querySelector('.toc-mobile'); if (!box) return;
      var now = box.querySelector('.toc-now');
      box.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { box.open = false; }); });
      var heads = Array.prototype.slice.call(document.querySelectorAll('.prose h2[id], .prose h3[id]'));
      function update() {
        var cur = heads[0];
        for (var i = 0; i < heads.length; i++) { if (heads[i].getBoundingClientRect().top < 140) cur = heads[i]; else break; }
        if (cur) now.textContent = cur.textContent;
      }
      window.addEventListener('scroll', update, { passive: true }); update();
    })();
  </script>
</Base>
