{
  "name": "taksyndicate-site",
  "compatibility_date": "2026-08-23",
  // Only handles /api/* (the shield form). Everything else is served straight from dist/.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The live domain. Cloudflare creates the DNS records for these itself.
  "routes": [
    { "pattern": "www.thetaksyndicate.org", "custom_domain": true },
    { "pattern": "thetaksyndicate.org", "custom_domain": true }
  ],
  "vars": {
    "SHIELD_TO": "thetaksyndicate@gmail.com"
  },
  // Cloudflare Email Routing. This binding can only send to this one verified address.
  "send_email": [
    { "name": "SHIELD_MAIL", "destination_address": "thetaksyndicate@gmail.com" }
  ],
  // Per-IP limit on the shield form (Turnstile is the main gate).
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Secret, set in the Cloudflare dashboard (never in git): TURNSTILE_SECRET
}
